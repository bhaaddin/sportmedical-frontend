{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/web",
      "destination": "/",
      "statusCode": 308
    },
    {
      "source": "/web/:path*",
      "destination": "/:path*",
      "statusCode": 308
    }
  ],
  "rewrites": [
    {
      "source": "/sluzby",
      "destination": "/sluzby/index.html"
    },
    {
      "source": "/prohlidky",
      "destination": "/prohlidky/index.html"
    },
    {
      "source": "/diagnostika",
      "destination": "/diagnostika/index.html"
    },
    {
      "source": "/inbody",
      "destination": "/inbody/index.html"
    },
    {
      "source": "/cenik",
      "destination": "/cenik/index.html"
    },
    {
      "source": "/dokumenty",
      "destination": "/dokumenty/index.html"
    },
    {
      "source": "/kontakt",
      "destination": "/kontakt/index.html"
    },
    {
      "source": "/o-nas",
      "destination": "/o-nas/index.html"
    },
    {
      "source": "/kluby",
      "destination": "/kluby/index.html"
    },
    {
      "source": "/faq",
      "destination": "/faq/index.html"
    },
    {
      "source": "/obchodni-podminky",
      "destination": "/obchodni-podminky/index.html"
    },
    {
      "source": "/ochrana-osobnich-udaju",
      "destination": "/ochrana-osobnich-udaju/index.html"
    },
    {
      "source": "/storno-a-reklamace",
      "destination": "/storno-a-reklamace/index.html"
    },
    {
      "source": "/vybaveni",
      "destination": "/vybaveni/index.html"
    },
    {
      "source": "/partneri",
      "destination": "/partneri/index.html"
    },
    {
      "source": "/diagnostika/zakladni",
      "destination": "/diagnostika/zakladni/index.html"
    },
    {
      "source": "/diagnostika/komplexni",
      "destination": "/diagnostika/komplexni/index.html"
    },
    {
      "source": "/diagnostika/vo2max",
      "destination": "/diagnostika/vo2max/index.html"
    },
    {
      "source": "/diagnostika/kompenzacni-plan",
      "destination": "/diagnostika/kompenzacni-plan/index.html"
    },
    {
      "source": "/((?!assets/).+)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://res.cloudinary.com; font-src 'self'; media-src 'self' blob: https://res.cloudinary.com; frame-src 'self' blob:; connect-src 'self' https://sportmedical-api.onrender.com wss://sportmedical-api.onrender.com blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(sluzby|prohlidky|diagnostika|inbody|cenik|dokumenty|kontakt|o-nas|kluby|faq|obchodni-podminky|ochrana-osobnich-udaju|storno-a-reklamace|vybaveni|partneri|diagnostika/zakladni|diagnostika/komplexni|diagnostika/vo2max|diagnostika/kompenzacni-plan)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(portal|klub|klub-objednavka|rezervace|dokonceni)/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}
