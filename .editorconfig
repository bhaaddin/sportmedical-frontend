# From sportmedical-ops/toolkit/baseline (sm-bootstrap, 2026-11-03). Matches .gitattributes (LF) and the existing 2-space code.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx,vb}]
indent_size = 4

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{ps1,psm1,bat,cmd}]
end_of_line = crlf
