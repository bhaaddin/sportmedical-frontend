      "backgroundColor": "#F4F6F7",
      "borderBottom": "1px solid #E2E6EA",
      "color": "#626B75",
      "fontSize": 11,
      "fontWeight": 700,
      "letterSpacing": "0.08em",
      "paddingBottom": 10,
      "paddingTop": 10,
      "textTransform": "uppercase"
     }
    }
   }
  },
  "MuiTableRow": {
   "styleOverrides": {
    "root": {
     "&.MuiTableRow-hover:hover": {
      "backgroundColor": "#F4F6F7"
     },
