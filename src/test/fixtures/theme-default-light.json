{
 "components": {
  "MuiAlert": {
   "styleOverrides": {
    "icon": {
     "opacity": 0.9
    },
    "root": {
     "alignItems": "center",
     "borderRadius": 10,
     "fontSize": 14
    },
    "standard": {
     "&.MuiAlert-colorError": {
      "backgroundColor": "#F5E0D8",
      "color": "#9B3B1B"
     },
     "&.MuiAlert-colorInfo": {
      "backgroundColor": "#F4F8F7",
      "color": "#1A1D21"
     },
     "&.MuiAlert-colorSuccess": {
      "backgroundColor": "#E2EBE4",
      "color": "#27603A"
     },
     "&.MuiAlert-colorWarning": {
      "backgroundColor": "#FBF1E7",
      "color": "#8A5A2F"
     }
    }
   }
  },
  "MuiAppBar": {
   "defaultProps": {
    "color": "inherit",
    "elevation": 0
   },
   "styleOverrides": {
    "root": {
     "backgroundColor": "#FFFFFF",
     "backgroundImage": "none",
     "borderBottom": "1px solid #E2E6EA",
     "boxShadow": "none",
     "color": "#1A1D21"
    }
   }
  },
  "MuiAvatar": {
   "styleOverrides": {
    "root": {
     "backgroundColor": "#EFF1F4",
     "color": "#1A1D21",
     "fontSize": 14,
     "fontWeight": 700
    }
   }
  },
  "MuiBackdrop": {
   "styleOverrides": {
    "root": {}
   }
  },
  "MuiButton": {
   "defaultProps": {
    "disableElevation": true
   },
   "styleOverrides": {
    "contained": {
     "&:hover": {
      "boxShadow": "none"
     },
     "boxShadow": "none"
    },
    "outlined": {
     "&.MuiButton-colorError": {
      "borderColor": "#E3C3BA",
      "color": "#9B3B1B"
     },
     "&.MuiButton-colorPrimary": {
      "borderColor": "rgba(13, 92, 82, 0.35)",
      "color": "#0D5C52"
     },
     "&:hover": {
      "backgroundColor": "#F4F6F7",
      "borderColor": "#DCE0E5"
     },
     "backgroundColor": "#FFFFFF",
     "borderColor": "#E2E6EA",
     "color": "#1A1D21"
    },
    "root": {
     "borderRadius": 10,
     "boxShadow": "none",
     "fontWeight": 600,
     "minHeight": 40,
     "paddingInline": 16,
     "textTransform": "none"
    },
    "sizeLarge": {
     "fontSize": 15,
     "minHeight": 48,
     "paddingInline": 22
    },
    "sizeSmall": {
     "fontSize": 13,
     "minHeight": 32,
     "paddingInline": 12
    },
    "text": {
     "&:hover": {
      "backgroundColor": "#F4F6F7"
     }
    }
   }
  },
  "MuiCard": {
   "styleOverrides": {
    "root": {
     "backgroundImage": "none",
     "border": "1px solid #E2E6EA",
     "borderRadius": 12,
     "boxShadow": "none"
    }
   }
  },
  "MuiCardContent": {
   "styleOverrides": {
    "root": {
     "&:last-child": {
      "paddingBottom": 20
     },
     "padding": 20
    }
   }
  },
  "MuiChip": {
   "styleOverrides": {
    "label": {
     "paddingInline": 10
    },
    "outlined": {
     "borderColor": "#E2E6EA"
    },
    "root": {
     "borderRadius": 999,
     "fontSize": 12,
     "fontWeight": 600,
     "height": 24
    },
    "sizeSmall": {
     "fontSize": 11,
     "height": 22
    }
   }
  },
  "MuiCssBaseline": {
   "styleOverrides": {
    "::selection": {
     "backgroundColor": "rgba(13, 92, 82, 0.18)"
    },
    "@media (max-width: 1279.95px)": {
     "body .MuiButton-root": {
      "minWidth": 44
     },
     "body .MuiButton-root, body .MuiToggleButton-root, body .MuiTab-root, body .MuiMenuItem-root, body .MuiListItemButton-root": {
      "minHeight": 44
     },
     "body .MuiButtonBase-root[aria-pressed]": {
      "minHeight": 44,
      "minWidth": 44
     },
     "body .MuiCheckbox-root, body .MuiRadio-root": {
      "padding": 10
     },
     "body .MuiCheckbox-sizeSmall, body .MuiRadio-sizeSmall": {
      "padding": 12
     },
     "body .MuiChip-root.MuiChip-clickable": {
      "minHeight": 44
     },
     "body .MuiIconButton-root:not(.MuiPickersArrowSwitcher-button)": {
      "minHeight": 44,
      "minWidth": 44
     },
     "body .MuiInputBase-input:not(.MuiInputBase-inputMultiline)": {
      "boxSizing": "border-box",
      "minHeight": 44
     },
     "body .MuiSwitch-root:not(.MuiSwitch-sizeSmall)": {
      "height": 44,
      "padding": "11px 8px"
     },
     "body .MuiSwitch-root:not(.MuiSwitch-sizeSmall) .MuiSwitch-switchBase": {
      "left": -3,
      "padding": 12,
      "top": 0
     }
    },
    "body": {
     "backgroundColor": "#EFF1F4",
     "color": "#1A1D21",
     "fontFamily": "\"Public Sans\", \"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"
    },
    "html": {
     "colorScheme": "light"
    }
   }
  },
  "MuiDialog": {
   "styleOverrides": {
    "paper": {
     "border": "none",
     "borderRadius": 14,
     "boxShadow": "0 24px 60px rgba(20, 24, 28, 0.20)"
    }
   }
  },
  "MuiDialogActions": {
   "styleOverrides": {
    "root": {
     "borderTop": "1px solid #E2E6EA",
     "gap": 8,
     "padding": "12px 24px 20px"
    }
   }
  },
  "MuiDialogContent": {
   "styleOverrides": {
    "root": {
     "padding": "8px 24px 16px"
    }
   }
  },
  "MuiDialogTitle": {
   "styleOverrides": {
    "root": {
     "fontSize": 20,
     "fontWeight": 700,
     "padding": "20px 24px 8px"
    }
   }
  },
  "MuiDivider": {
   "styleOverrides": {
    "root": {
     "borderColor": "#E2E6EA"
    }
   }
  },
  "MuiDrawer": {
   "styleOverrides": {
    "paper": {
     "backgroundImage": "none",
     "borderRadius": 0,
     "boxShadow": "none"
    }
   }
  },
  "MuiFormHelperText": {
   "styleOverrides": {
    "root": {
     "marginLeft": 2
    }
   }
  },
  "MuiIconButton": {
   "styleOverrides": {
    "root": {
     "borderRadius": 8
    }
   }
  },
  "MuiInputLabel": {
   "styleOverrides": {
    "root": {
     "fontSize": 14
    }
   }
  },
  "MuiLinearProgress": {
   "styleOverrides": {
    "bar": {
     "borderRadius": 999
    },
    "root": {
     "backgroundColor": "#E2E6EA",
     "borderRadius": 999,
     "height": 6
    }
   }
  },
  "MuiListItemButton": {
   "styleOverrides": {
    "root": {
     "&.Mui-selected": {
      "&:hover": {
       "backgroundColor": "#F4F8F7"
      },
      "backgroundColor": "#F4F8F7",
      "color": "#0D5C52"
     },
     "borderRadius": 8
    }
   }
  },
  "MuiMenu": {
   "styleOverrides": {
    "list": {
     "padding": 6
    },
    "paper": {
     "border": "1px solid #E2E6EA",
     "borderRadius": 10,
     "boxShadow": "0 12px 32px rgba(20, 24, 28, 0.14)"
    }
   }
  },
  "MuiMenuItem": {
   "styleOverrides": {
    "root": {
     "&:hover": {
      "backgroundColor": "#F4F6F7"
     },
     "borderRadius": 8,
     "fontSize": 14,
     "minHeight": 36
    }
   }
  },
  "MuiOutlinedInput": {
   "styleOverrides": {
    "input": {
     "paddingBottom": 11,
     "paddingTop": 11
    },
    "root": {
     "& .MuiOutlinedInput-notchedOutline": {
      "borderColor": "#E2E6EA"
     },
     "&.Mui-focused .MuiOutlinedInput-notchedOutline": {
      "borderColor": "#0D5C52",
      "borderWidth": 2
     },
     "&:hover .MuiOutlinedInput-notchedOutline": {
      "borderColor": "rgba(13, 92, 82, 0.5)"
     },
     "backgroundColor": "#FFFFFF",
     "borderRadius": 10
    }
   }
  },
  "MuiPaper": {
   "defaultProps": {
    "elevation": 0
   },
   "styleOverrides": {
    "root": {
     "__fn": {
      "0": {
       "backgroundImage": "none",
       "border": "1px solid #E2E6EA",
       "borderRadius": 12,
       "boxShadow": "none"
      },
      "1": {
       "backgroundImage": "none",
       "border": "1px solid #E2E6EA",
       "borderRadius": 12,
       "boxShadow": "none"
      },
      "2": {
       "backgroundImage": "none",
       "border": "1px solid #E2E6EA",
       "borderRadius": 12,
       "boxShadow": "0 12px 32px rgba(20, 24, 28, 0.14)"
      },
      "3": {
       "backgroundImage": "none",
       "borderRadius": 12,
       "boxShadow": "0 24px 60px rgba(20, 24, 28, 0.20)"
      },
      "4": {
       "backgroundImage": "none",
       "borderColor": "#E2E6EA",
       "borderRadius": 12,
       "boxShadow": "none"
      },
      "5": {
       "backgroundImage": "none",
       "border": "1px solid #E2E6EA",
       "borderRadius": 12,
       "boxShadow": "none"
      }
     }
    }
   }
  },
  "MuiPopover": {
   "styleOverrides": {
    "paper": {
     "border": "1px solid #E2E6EA",
     "borderRadius": 10,
     "boxShadow": "0 12px 32px rgba(20, 24, 28, 0.14)"
    }
   }
  },
  "MuiSkeleton": {
   "styleOverrides": {
    "root": {
     "borderRadius": 8
    }
   }
  },
  "MuiSwitch": {
   "styleOverrides": {
    "root": {
     "padding": 8
    },
    "track": {
     "borderRadius": 999
    }
   }
  },
  "MuiTab": {
   "styleOverrides": {
    "root": {
     "&.Mui-selected": {
      "color": "#0D5C52"
     },
     "color": "#626B75",
     "fontSize": 14,
     "fontWeight": 600,
     "minHeight": 44,
     "textTransform": "none"
    }
   }
  },
  "MuiTableCell": {
   "styleOverrides": {
    "root": {
     "borderBottom": "1px solid #E2E6EA",
