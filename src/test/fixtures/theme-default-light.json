      "borderBottom": 0
     }
    }
   }
  },
  "MuiTabs": {
   "styleOverrides": {
    "indicator": {
     "backgroundColor": "#0D5C52",
     "height": 2
    },
    "root": {
     "borderBottom": "1px solid #E2E6EA",
     "minHeight": 44
    }
   }
  },
  "MuiToggleButton": {
   "styleOverrides": {
    "root": {
     "&.Mui-selected": {
      "&:hover": {
       "backgroundColor": "#0D5C52"
      },
      "backgroundColor": "#0D5C52",
      "borderColor": "#0D5C52",
      "color": "#FFFFFF"
     },
     "color": "#1A1D21",
     "fontSize": 13,
     "fontWeight": 600,
     "minHeight": 38,
     "paddingInline": 14,
     "textTransform": "none"
    }
   }
  },
  "MuiToggleButtonGroup": {
   "styleOverrides": {
    "grouped": {
     "&:not(:first-of-type)": {
      "borderLeft": "1px solid #E2E6EA",
      "marginLeft": -1
     },
     "border": "1px solid #E2E6EA"
    },
    "root": {
     "backgroundColor": "#FFFFFF",
     "borderRadius": 10
    }
   }
  },
  "MuiTooltip": {
   "styleOverrides": {
    "arrow": {
     "color": "#14181C"
    },
    "tooltip": {
     "backgroundColor": "#14181C",
     "borderRadius": 8,
     "fontSize": 12,
     "fontWeight": 500,
     "padding": "6px 10px"
    }
   }
  }
 },
