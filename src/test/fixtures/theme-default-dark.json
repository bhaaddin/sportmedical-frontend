    }
   }
  },
  "MuiBackdrop": {
   "styleOverrides": {
    "root": {
     "&:not(.MuiBackdrop-invisible)": {
      "backdropFilter": "blur(5px)",
      "backgroundColor": "rgba(0, 7, 16, 0.73)"
     }
    }
   }
  },
  "MuiButton": {
   "defaultProps": {
    "disableElevation": true
