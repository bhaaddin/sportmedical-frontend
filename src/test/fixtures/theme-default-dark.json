     "&.MuiButton-colorPrimary": {
      "borderColor": "rgba(50, 181, 199, 0.79)",
      "color": "#DDFFFF"
     },
     "&:hover": {
      "backgroundColor": "#0C384C",
      "backgroundImage": "linear-gradient(105deg, #07576B, #074154)",
      "borderColor": "#74FFF4",
      "boxShadow": "0 0 12px rgba(4, 235, 221, 0.21)"
