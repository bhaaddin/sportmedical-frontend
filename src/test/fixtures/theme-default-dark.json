     "color": "#BCD0E1",
     "fontSize": 12,
     "fontWeight": 600,
     "height": 24
    },
    "sizeSmall": {
     "fontSize": 11,
     "height": 22
    }
   }
  },
  "MuiCssBaseline": {
   "styleOverrides": {
    "*::-webkit-scrollbar": {
     "height": 10,
     "width": 10
    },
    "*::-webkit-scrollbar-thumb": {
     "backgroundColor": "#0A5670",
     "border": "2px solid #001421",
     "borderRadius": 999
    },
    "*::-webkit-scrollbar-thumb:hover": {
     "backgroundColor": "#087E97"
    },
    "*::-webkit-scrollbar-track": {
     "background": "transparent"
    },
    "::selection": {
     "backgroundColor": "rgba(0, 230, 228, 0.35)"
    },
    "@media (max-width: 1279.95px)": {
     "body .MuiButton-root": {
      "minWidth": 44
     },
     "body .MuiButton-root, body .MuiToggleButton-root, body .MuiTab-root, body .MuiMenuItem-root, body .MuiListItemButton-root": {
      "minHeight": 44
     },
     "body .MuiButtonBase-root[aria-pressed]": {
      "minHeight": 44,
      "minWidth": 44
     },
     "body .MuiCheckbox-root, body .MuiRadio-root": {
      "padding": 10
     },
     "body .MuiCheckbox-sizeSmall, body .MuiRadio-sizeSmall": {
      "padding": 12
     },
     "body .MuiChip-root.MuiChip-clickable": {
      "minHeight": 44
     },
     "body .MuiIconButton-root:not(.MuiPickersArrowSwitcher-button)": {
      "minHeight": 44,
      "minWidth": 44
     },
     "body .MuiInputBase-input:not(.MuiInputBase-inputMultiline)": {
      "boxSizing": "border-box",
      "minHeight": 44
     },
     "body .MuiSwitch-root:not(.MuiSwitch-sizeSmall)": {
      "height": 44,
      "padding": "11px 8px"
     },
     "body .MuiSwitch-root:not(.MuiSwitch-sizeSmall) .MuiSwitch-switchBase": {
      "left": -3,
      "padding": 12,
      "top": 0
     }
    },
    "body": {
     "backgroundAttachment": "fixed",
     "backgroundColor": "#001421",
     "backgroundImage": "radial-gradient(ellipse at 85% 0%, #05364C 0%, transparent 44%), linear-gradient(120deg, #00111E, #00182A 70%, #00131F)",
     "color": "#F4FAFF",
     "fontFamily": "\"Public Sans\", \"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
     "scrollbarColor": "#0A5670 #001421"
    },
    "body .sm-planner": {
     "backgroundColor": "transparent"
    },
    "body .sm-planner #dashboard.live-mode": {
     "background": "radial-gradient(ellipse 62% 28% at 65% 94%, rgba(0, 103, 139, 0.18), transparent 83%)",
     "backgroundColor": "transparent"
    },
    "html": {
     "colorScheme": "dark"
    }
   }
  },
