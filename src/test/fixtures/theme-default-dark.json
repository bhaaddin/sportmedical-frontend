      "background": "linear-gradient(105deg, #24F8E0, #06CBBB)",
      "border": "1px solid #0BEAD7",
      "boxShadow": "inset 0 1px rgba(184, 255, 247, 0.43), 0 0 18px rgba(0, 233, 199, 0.18)",
      "color": "#001E2C",
      "fontWeight": 700
     },
     "&:hover": {
      "boxShadow": "none"
