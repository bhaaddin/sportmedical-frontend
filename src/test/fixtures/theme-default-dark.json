{
 "components": {
  "MuiAlert": {
   "styleOverrides": {
    "icon": {
     "opacity": 0.9
    },
    "root": {
     "alignItems": "center",
     "borderRadius": 10,
     "fontSize": 14
    },
    "standard": {
     "&.MuiAlert-colorError": {
      "backgroundColor": "rgba(255, 25, 80, 0.14)",
      "color": "#FF7B98"
     },
     "&.MuiAlert-colorInfo": {
      "backgroundColor": "rgba(0, 230, 228, 0.12)",
      "color": "#F4FAFF"
     },
     "&.MuiAlert-colorSuccess": {
      "backgroundColor": "rgba(0, 229, 198, 0.12)",
      "color": "#4DF2DA"
     },
     "&.MuiAlert-colorSuccess, &.MuiAlert-colorWarning, &.MuiAlert-colorError, &.MuiAlert-colorInfo": {
      "border": "1px solid rgba(0, 230, 228, 0.22)"
     },
     "&.MuiAlert-colorWarning": {
      "backgroundColor": "rgba(255, 178, 31, 0.12)",
      "color": "#FFC857"
     }
    }
   }
  },
  "MuiAppBar": {
   "defaultProps": {
    "color": "inherit",
    "elevation": 0
   },
   "styleOverrides": {
    "root": {
     "backdropFilter": "blur(14px)",
     "backgroundColor": "rgba(0, 19, 33, 0.94)",
     "backgroundImage": "none",
     "borderBottom": "1px solid #087E97",
     "boxShadow": "none",
     "color": "#F4FAFF"
    }
   }
  },
  "MuiAvatar": {
   "styleOverrides": {
    "root": {
     "backgroundColor": "#0A3C52",
     "color": "#F4FAFF",
     "fontSize": 14,
