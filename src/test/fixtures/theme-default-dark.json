     "backgroundColor": "#021C2D",
     "backgroundImage": "linear-gradient(105deg, #063649, #072A3D)",
     "borderColor": "rgba(50, 181, 199, 0.79)",
     "boxShadow": "inset 0 1px rgba(255, 255, 255, 0.07), 0 2px 8px rgba(0, 0, 0, 0.4)",
     "color": "#DDFFFF"
